# ===================================================
# VELLISTO STUDIO - CONFIGURATION & CREDENTIALS
# ===================================================

# 1. Discord Bot Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 2. Discord Channel ID (leads / inquiries channel)
DISCORD_LEADS_CHANNEL_ID=your_leads_channel_id

# 3. Discord Category ID (for dedicated client channels)
DISCORD_CLIENTS_CATEGORY_ID=your_category_id

# 4. Resend Email API Key
RESEND_API_KEY=your_resend_api_key

# 5. Email "From" Address
RESEND_FROM_EMAIL=Krishna | Vellisto <hello@vellisto.com>

# 6. Fallback Discord Webhook
DISCORD_WEBHOOK_URL=your_discord_webhook_url
